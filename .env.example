# Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
# Generate a cryptographically random value of at least 32 characters.
JWT_SECRET=
# Exact public browser origin; use HTTPS on deployment.
APP_ORIGIN=http://127.0.0.1:3100
# Verified TLS is the default. Set false only for a local PostgreSQL server.
DATABASE_SSL=true
# Local development only: false keeps encryption but skips certificate verification.
DATABASE_SSL_VERIFY=true
# Optional provider CA as PEM text, or path to its public certificate file.
# DATABASE_CA_CERT=
# DATABASE_CA_CERT_FILE=certs/database-ca.crt
# If your provider requires a private CA, configure NODE_EXTRA_CA_CERTS to its trusted PEM file.
# Dedicated disposable database only; never point this at your application database.
# TEST_DATABASE_URL=
# Optional showcase seeding (resets this account's existing roster/matches).
# SEED_EMAIL=
# SEED_PASSWORD=
