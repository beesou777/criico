# PostgreSQL Connection String (Supabase, Neon, AWS RDS, or local PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# JWT Secret for signing HTTP-only session cookies (must be at least 32 characters)
JWT_SECRET=criico_super_secret_grassroots_jwt_key_32_chars_long

# Node environment
NODE_ENV=development
